# FreeDeck server configuration — copy to .env and edit.

# Root of the FreeDeck storage (ipa/, apps/, webports/, library.json).
# For bare-metal uvicorn runs on the 240GB server, use e.g. /freedeck_storage.
# Inside docker-compose this is mounted as a named volume at /freedeck_storage.
FREEDECK_STORAGE_ROOT=/freedeck_storage

# Optional bearer-token auth for /api/* and /stream/*.
# Leave empty to disable auth (fine over Tailscale-only networking).
FREEDECK_TOKEN=

# Host port nginx listens on (docker-compose only). Reach the server at
# http://freedeck.tailnet.ts.net:8080/ over Tailscale MagicDNS.
FREEDECK_HTTP_PORT=8080
